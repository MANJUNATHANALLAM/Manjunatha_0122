#include <stdio.h>
#include <string.h>

int main() {
    int n, e, i, j;
    
    printf("Enter number of vertices: ");
    scanf("%d", &n);

    char vertices[n][20];
    printf("Enter vertex names:\n");
    for (i = 0; i < n; i++) {
        scanf("%s", vertices[i]);
    }

    int adj[n][n];

    /* Initialize matrix with zeros */
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            adj[i][j] = 0;
        }
    }

    printf("Enter number of edges: ");
    scanf("%d", &e);

    printf("Enter undirected edges (vertex1 vertex2):\n");
    for (i = 0; i < e; i++) {
        char v1[20], v2[20];
        scanf("%s %s", v1, v2);

        int a = -1, b = -1;

        for (j = 0; j < n; j++) {
            if (strcmp(vertices[j], v1) == 0)
                a = j;
            if (strcmp(vertices[j], v2) == 0)
                b = j;
        }

        if (a != -1 && b != -1) {
            adj[a][b] = 1;
            adj[b][a] = 1;   // Undirected graph
        }
    }

    /* Display adjacency matrix */
    printf("\nAdjacency Matrix:\n\n");

    printf("    ");
    for (i = 0; i < n; i++) {
        printf("%4s", vertices[i]);
    }
    printf("\n");

    for (i = 0; i < n; i++) {
        printf("%4s", vertices[i]);
        for (j = 0; j < n; j++) {
            printf("%4d", adj[i][j]);
        }
        printf("\n");
    }

    /* Verify symmetry */
    int symmetric = 1;
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (adj[i][j] != adj[j][i]) {
                symmetric = 0;
                break;
            }
        }
    }

    if (symmetric)
        printf("\nThe adjacency matrix is symmetric.\n");
    else
        printf("\nThe adjacency matrix is NOT symmetric.\n");

    return 0;
}
